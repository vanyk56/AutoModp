{
  "$schema": "https://railway.app/railway-schema.json",
  "build": {
    "builder": "NIXPACKS",
    "installCommand": "pnpm install --no-frozen-lockfile",
    "buildCommand": "NODE_ENV=development pnpm install --no-frozen-lockfile && pnpm --filter @workspace/crm-dashboard run build && pnpm --filter @workspace/api-server run build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @workspace/db run push && node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "healthcheckPath": "/api/healthz",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
